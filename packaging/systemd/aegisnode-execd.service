# Systemd Service Unit cho AegisNode Privileged Execution Daemon (Phase 20 Privilege Separation)
# Chạy tiến trình execd với Linux Capabilities tối thiểu và thiết lập sandbox cách ly chặt chẽ

[Unit]
Description=AegisNode Privileged Execution Daemon (execd)
Documentation=https://github.com/phucle996/AegisNode
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/aegisnode execd
Restart=on-failure
RestartSec=3s

# --- Systemd Hardening & Sandbox Security ---
# Ngăn cản quyền nâng cao mới
NoNewPrivileges=true

# Bảo vệ hệ thống tập tin hệ thống (Read-Only ngoại trừ /run/aegisnode)
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

# Giới hạn Linux Capabilities tối thiểu cho nftables và network operations
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

# Chỉ cho phép khởi tạo đường dẫn runtime socket
RuntimeDirectory=aegisnode
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
