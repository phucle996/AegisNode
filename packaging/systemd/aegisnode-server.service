[Unit]
Description=AegisNode Central Controller Server Daemon
Documentation=https://github.com/phucle996/AegisNode
After=network.target network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=aegisnode
Group=aegisnode
ExecStart=/usr/bin/aegisnode server --config /etc/aegisnode/controller.yaml
Restart=on-failure
RestartSec=5s

# Security Hardening Settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/aegisnode
ReadWritePaths=/var/log/aegisnode

[Install]
WantedBy=multi-user.target
